# Boomerang environment configuration.
# Copy this file to .env and fill in the values you actually use.

# Default embedding backend for most commands is Gemini.
# Required when using:
# - `boomerang init`
# - `boomerang index ... --backend gemini`
# - `boomerang search ...` when the index was built with Gemini
# - query expansion during text search with Gemini-backed search
GEMINI_API_KEY=

# Required only when using the DashScope / Qwen Cloud backend.
# Used by:
# - `boomerang index ... --backend qwen-cloud`
# - `boomerang search ... --backend qwen-cloud`
# - `boomerang img ... --backend qwen-cloud`
# - any command that targets a Qwen Cloud-built index
DASHSCOPE_API_KEY=

# Optional. Qwen Cloud model override.
# If empty, the Rust code defaults to `qwen3-vl-embedding`.
# Only relevant when you pass `--backend qwen-cloud`.
# Example:
# DASHSCOPE_EMBEDDING_MODEL=qwen3-vl-embedding
DASHSCOPE_EMBEDDING_MODEL=

# Optional. Qdrant base URL for the vector store.
# The Rust code defaults to `http://localhost:6333` if this is unset.
# Change this only if Qdrant is running on another host or port.
QDRANT_URL=http://localhost:6333

# Optional. Logging filter for local runs.
# `boomerang --verbose ...` raises logging to debug regardless of this default.
# Examples:
# RUST_LOG=boomerang=info
# RUST_LOG=boomerang=debug
RUST_LOG=boomerang=info

# Notes:
# - The `local` embedding backend is listed in the CLI, but it is not implemented in the Rust code yet.
# - `BOOMERANG_DB_PATH` is not used by the current Rust workspace, so it is intentionally omitted here.
